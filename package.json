{
  "name": "ihumbak-website",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "test": "eleventy --quiet && node --test \"test/**/*.test.js\"",
    "test:update": "eleventy --quiet && UPDATE_SNAPSHOTS=1 node --test test/snapshot.test.js"
  },
  "description": "iHumbak.website, generated with Eleventy",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "markdown-it": "^15.0.3",
    "node-html-parser": "^9.0.7"
  },
  "private": true,
  "type": "module"
}
